{
	"name": "workbench-monorepo",
	"version": "0.2.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"description": "Workbench monorepo — desktop, server, mobile, and shared packages",
	"type": "module",
	"packageManager": "bun@1.3.7",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev --filter=@workbench/desktop",
		"build": "turbo run build",
		"check": "turbo run check",
		"lint": "prettier --check . && turbo run lint",
		"format": "prettier --write .",
		"test": "turbo run test"
	},
	"devDependencies": {
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"turbo": "^2.5.0"
	}
}
