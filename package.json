{
	"name": "workbench-monorepo",
	"version": "0.2.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"description": "Workbench monorepo — desktop, server, mobile, and shared packages",
	"type": "module",
	"packageManager": "bun@1.3.7",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"catalog": {
		"@lucide/svelte": "^1.17.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/cli": "^2.11.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.9.2",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"dev": "turbo run dev --filter=@workbench/desktop",
		"build": "turbo run build",
		"check": "turbo run check",
		"lint": "prettier --check . && turbo run lint",
		"format": "prettier --write .",
		"test": "turbo run test"
	},
	"devDependencies": {
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"turbo": "^2.5.0"
	}
}
