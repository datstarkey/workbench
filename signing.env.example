# Apple code signing + notarization for local release builds.
# Copy to `signing.env` (gitignored) and fill in. See docs/SIGNING.md.
#
# Only used by `bun run build:signed`. Plain `bun run dev` / `bun run build`
# ignore these entirely and produce unsigned builds.

# Full certificate common name, exactly as `security find-identity -v -p codesigning` prints it.
export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# App Store Connect API key used for notarization.
export APPLE_API_KEY=ABCD123456
export APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
export APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABCD123456.p8"

# Updater signing (minisign) — without it the build emits no updater artifact.
export TAURI_SIGNING_PRIVATE_KEY="$HOME/.tauri/workbench.key"
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
