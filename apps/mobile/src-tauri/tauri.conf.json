{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Workbench",
	"version": "0.1.0",
	"identifier": "com.workbench.mobile",
	"build": {
		"beforeDevCommand": "bun run vite",
		"devUrl": "http://localhost:1430",
		"beforeBuildCommand": "bun run vite build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "Workbench"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
